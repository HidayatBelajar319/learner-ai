# ============ Env vars (deploy ke wrangler.toml [vars]) ============

# Key default server-side (fallback jika user belum simpan key BYOK)
MISTRAL_API_KEY=your_mistral_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Deploy
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
JWT_SECRET=your_jwt_secret_min_32_chars

# ============ Provider yang didukung (BYOK di halaman Pengaturan) ============
# - OpenRouter        : https://openrouter.ai/api/v1
# - OpenAI            : https://api.openai.com/v1
# - Mistral AI        : https://api.mistral.ai/v1
# - Anthropic         : https://api.anthropic.com/v1
# - Google Gemini     : https://generativelanguage.googleapis.com/v1beta
# - OmniRoute (Local) : http://localhost:20128/v1  (hanya jalan via `wrangler dev`, bukan di worker ter-deploy)
#
# OmniRoute adalah gateway LLM lokal (npm install -g omniroute).
# Jalankan `omniroute` di mesin kamu, lalu di Pengaturan > API Key AI:
#   Endpoint URL : http://localhost:20128/v1
#   Model        : auto
# Worker hanya bisa mengakses localhost saat dijalankan via `wrangler dev`.
